# Contract Review & Risk Analysis System - Environment Configuration
# Copy this file to .env and update the values as needed

# API Configuration
API_TOKEN=devtoken
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
MODEL_SNAPSHOT=snapshot_20250909
ARTIFACTS_DIR=phase3_mvp/artifacts/snapshot_20250909

# RAG Configuration
RAG_COLLECTION=cuad-safe-clauses
RAG_INDEX_DIR=phase3_mvp/rag/index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database Configuration (for future use)
DATABASE_URL=sqlite:///./contract_analysis.db
REDIS_URL=redis://localhost:6379

# Security Configuration
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,text/plain

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Development/Production Mode
ENVIRONMENT=development
DEBUG=true
